# MAHIKS-TR Environment Configuration
# Copy this file to .env and fill in your actual values

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mahiks_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=medical_chunks

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# Text Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval Settings
VECTOR_TOP_K=5
GRAPH_MAX_DEPTH=2

# Data Directory - location for raw documents
DATA_DIR=./data/raw_documents
