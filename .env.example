# MAHIKS-TR Environment Configuration
# Copy this file to .env and fill in your actual values

# MySQL Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mahiks_password
MYSQL_DATABASE=mahiks_db

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mahiks_neo4j_password

# ChromaDB
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_NAME=medical_chunks

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Embedding Model (changing this requires re-indexing all documents)
EMBEDDING_MODEL=BAAI/bge-m3

# Knowledge Graph Extraction
# Method: "local" (Ollama, default), "gemini" (API), or "auto" (auto-select)
KG_EXTRACTION_METHOD=local
KG_OLLAMA_MODEL=qwen2.5:7b
KG_CHUNK_SIZE=3000
# Only needed if KG_EXTRACTION_METHOD=gemini or auto
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# JWT Authentication (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# Text Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval Settings
VECTOR_TOP_K=5
GRAPH_MAX_DEPTH=2

# Conversation Settings
CONVERSATION_HISTORY_LIMIT=6
MAX_GENERATION_TOKENS=2000

# Data Directory - location for raw documents
DATA_DIR=./data/raw_documents

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL=3600
