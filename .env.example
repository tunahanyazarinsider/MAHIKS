# MAHIKS-TR Environment Configuration
# Copy this file to .env and fill in your actual values

# ─── Databases ────────────────────────────────────────────────────────────────

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mahiks_password
MYSQL_DATABASE=mahiks_db

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mahiks_neo4j_password

# Qdrant (hybrid dense + sparse BM25)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=sut_documents
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_SPARSE_LANGUAGE=turkish
QDRANT_DENSE_DIM=1024

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL=3600

# ─── Embedding ────────────────────────────────────────────────────────────────
# Changing this requires re-indexing all documents
EMBEDDING_MODEL=BAAI/bge-m3

# ─── Generation LLM ───────────────────────────────────────────────────────────
# Which provider powers the answer-generation step.
# Options: ollama (default) | openai | openrouter | gemini | vertex
LLM_PROVIDER=ollama

# Ollama — runs on the host machine, outside Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI — only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (generation) — only needed if LLM_PROVIDER=openrouter
# Note: OPENROUTER_API_KEY is shared with KG extraction if both use OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_LLM_MODEL=qwen/qwen-2.5-72b-instruct
# OPENROUTER_REFERER=https://your-app.example
# OPENROUTER_TITLE=MAHIKS-TR

# Gemini Developer API — only needed if LLM_PROVIDER=gemini
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is accepted as fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI — only needed if LLM_PROVIDER=vertex
# Uses Application Default Credentials — run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# ─── Knowledge Graph Extraction ───────────────────────────────────────────────
# Can use a different provider and model from generation.
# Options: ollama (default) | gemini | vertex | openrouter
KG_EXTRACTION_METHOD=ollama
KG_CHUNK_SIZE=3000

# Ollama KG — inherits OLLAMA_BASE_URL from the generation section
KG_OLLAMA_MODEL=qwen2.5:7b

# Gemini KG — inherits GEMINI_API_KEY and GEMINI_MODEL from the generation section
# Override model here only if you want a different model for KG vs generation
KG_GEMINI_MODEL=gemini-2.5-flash

# Vertex KG — inherits GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION
# Override model here only if you want a different model for KG vs generation
KG_VERTEX_MODEL=gemini-2.5-flash

# OpenRouter KG — inherits OPENROUTER_API_KEY from the generation section
# Override model here only if you want a different model for KG vs generation
KG_OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ─── Judge Model (for evaluation) ───────────────────────────────────────────────
# Can use a different provider and model from generation.
# Options: ollama (default) | gemini | vertex | openrouter
JUDGE_MODEL_PROVIDER=ollama
JUDGE_MODEL_OLLAMA=qwen2.5:7b
JUDGE_MODEL_GEMINI=gemini-2.5-flash
JUDGE_MODEL_VERTEX=gemini-2.5-flash
JUDGE_MODEL_OPENROUTER=qwen/qwen-2.5-72b-instruct

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
CORS_ORIGINS=*

# ─── Text Processing ──────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# SUT-aware chunker
SUT_MAX_WORDS=350
SUT_MIN_WORDS=100
SUT_MERGE_THRESHOLD=75

# ─── Retrieval ────────────────────────────────────────────────────────────────
VECTOR_TOP_K=5
GRAPH_MAX_DEPTH=2

# ─── Conversation & Generation ────────────────────────────────────────────────
CONVERSATION_HISTORY_LIMIT=6
MAX_GENERATION_TOKENS=2000

# ─── Data ─────────────────────────────────────────────────────────────────────
DATA_DIR=./data/raw_documents
