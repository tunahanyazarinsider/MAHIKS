# MAHIKS-TR Environment Configuration
# Copy this file to .env and fill in your actual values

# MySQL Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mahiks_password
MYSQL_DATABASE=mahiks_db

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mahiks_neo4j_password

# ChromaDB
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_NAME=medical_chunks

OLLAMA_BASE_URL=http://host.docker.internal:11434

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# Text Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval Settings
VECTOR_TOP_K=5
GRAPH_MAX_DEPTH=2

# Data Directory - location for raw documents
DATA_DIR=./data/raw_documents

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL=3600
